# ============================================
# EXON SCIENCES LMS - BACKEND ENVIRONMENT VARS
# ============================================
# Copy this file to .env and fill in your values

# --- App ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Set these when deployed to Vercel+Railway:
# FRONTEND_URL=https://your-project.vercel.app          (prod Vercel URL)
# FRONTEND_URL_DEV=https://your-project-dev.vercel.app  (dev Vercel URL)
# FRONTEND_VERCEL_DOMAIN=your-project                   (Vercel project name, enables preview URL CORS)

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://exon_user:your_secure_password@localhost:5432/exon_lms"

# --- Contentstack ---
CS_API_KEY=bltbcf7a701fcd769e7
CS_DELIVERY_TOKEN=blt6986713cb6f978ef
CS_ENVIRONMENT=development
CS_REGION=EU

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_256bit_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_another_256bit_random_string
JWT_REFRESH_EXPIRY=7d

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@exonsciences.com

# --- AWS S3 (certificate PDFs) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=exon-lms-certificates

# --- Stripe (payments) ---
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) during development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# For production sending to real inboxes — get from Mailtrap → Email Sending → API Tokens
MAILTRAP_SENDING_TOKEN=your_mailtrap_sending_token

# Resend — free production email (3,000/month, no domain needed)
# Get API key from https://resend.com → API Keys
# When set, this takes priority over Mailtrap for sending real emails
RESEND_API_KEY=re_your_resend_api_key

# Admin alert email — receives payment failures, system errors etc.
ADMIN_EMAIL=admin@exonsciences.co.uk
